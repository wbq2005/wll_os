+    }
+    if hinted {
+        MMAP_HINTED.fetch_add(1, Ordering::Relaxed);
+    }
+    if lazy {
+        MMAP_LAZY.fetch_add(1, Ordering::Relaxed);
+    } else {
+        MMAP_EAGER.fetch_add(1, Ordering::Relaxed);
+    }
+}
