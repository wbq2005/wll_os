+#[inline]
+fn mmap_length_bucket(length: usize) -> usize {
+    if length <= 64 * 1024 {
+        0
+    } else if length <= 1024 * 1024 {
+        1
+    } else if length <= 16 * 1024 * 1024 {
+        2
+    } else if length <= 256 * 1024 * 1024 {
+        3
+    } else {
+        4
+    }
+}
